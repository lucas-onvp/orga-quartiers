# Copier ce fichier vers .env.local puis remplir les valeurs.
# (npm run dev / Vercel lisent automatiquement .env.local)

# Mot de passe unique partagé pour débloquer l'application
APP_PASSWORD=change-moi

# Projet Supabase : Project Settings -> API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé "service_role" SECRETE (eyJ...) — ne JAMAIS la préfixer NEXT_PUBLIC,
# elle reste côté serveur uniquement.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
